# Copie para .env e preencha com os valores do seu backend.
# Nunca versione o .env com valores reais.

# --- Cliente (navegador) — apenas chaves públicas/publishable ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Servidor (server functions / SSR) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Chave secreta: só no ambiente do servidor / secrets do backend.
# NUNCA usar prefixo VITE_ e nunca commitar o valor.
SUPABASE_SERVICE_ROLE_KEY=
